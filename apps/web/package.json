{
    "name": "web",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "yarn generate:tokens && next dev --webpack",
        "dev:worker": "wrangler dev",
        "dev:all": "yarn dev & yarn dev:worker",
        "build": "yarn generate:tokens && next build --webpack",
        "build:report": "yarn build && node report-sizes.mjs",
        "deploy:worker": "wrangler deploy",
        "start": "next start",
        "lint": "eslint",
        "lint:style": "stylelint '**/*.scss'",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "clean": "rm -rf .next node_modules/.cache",
        "dev:clean": "yarn clean && yarn dev",
        "generate:tokens": "yarn workspace @dival-sehgal/design-tokens build",
        "generate:graphql": "graphql-codegen --config codegen.ts"
    },
    "dependencies": {
        "@contentful/rich-text-react-renderer": "^16.2.1",
        "@dival-sehgal/design-tokens": "*",
        "@dival-sehgal/next-config": "*",
        "@ducanh2912/next-pwa": "^10.2.9",
        "@emotion/cache": "^11.14.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@graphql-codegen/cli": "^7.0.0",
        "@hookform/resolvers": "^5.2.2",
        "@mui/icons-material": "^7.3.5",
        "@mui/material": "^7.3.5",
        "@mui/system": "^7.3.5",
        "@react-three/drei": "^10.7.7",
        "@react-three/fiber": "^9.5.0",
        "@tsparticles/react": "^3.0.0",
        "@tsparticles/slim": "^3.9.1",
        "clsx": "^2.1.1",
        "dotenv": "^17.4.2",
        "framer-motion": "^12.36.0",
        "graphql": "^16.13.2",
        "graphql-request": "^7.4.0",
        "maath": "^0.10.8",
        "next": "16.1.6",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "react-hook-form": "^7.66.0",
        "sass": "^1.93.3",
        "three": "^0.183.2",
        "tsparticles-engine": "^2.12.0",
        "wrangler": "^4.87.0",
        "zod": "^4.1.12"
    },
    "devDependencies": {
        "@dival-sehgal/eslint-config": "*",
        "@dival-sehgal/jest-config": "*",
        "@fullhuman/postcss-purgecss": "^8.0.0",
        "@types/three": "^0.183.1",
        "babel-plugin-react-compiler": "1.0.0",
        "purgecss": "^8.0.0",
        "stylelint": "^16.26.1",
        "stylelint-config-clean-order": "^8.0.1",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-declaration-strict-value": "^1.11.1",
        "stylelint-selector-bem-pattern": "^4.0.1"
    }
}
