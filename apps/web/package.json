{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "cd ../../packages/design-tokens && node build-tokens.js && cd ../../apps/web && node scripts/generate-architecture.mjs && node scripts/sync-translations.mjs",
    "dev": "next dev",
    "prebuild": "cd ../../packages/design-tokens && node build-tokens.js && cd ../../apps/web && node scripts/generate-architecture.mjs && node scripts/sync-translations.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:style": "stylelint 'src/**/*.scss'",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "worker:deploy": "wrangler deploy",
    "worker:tail": "wrangler tail --format pretty",
    "seed": "node scripts/seed-chatbot.mjs",
    "test:e2e": "playwright test",
    "architecture": "node scripts/generate-architecture.mjs",
    "report:sizes": "node scripts/report-sizes.mjs",
    "contentful:check-tokens": "node scripts/check-contentful-tokens.mjs",
    "translations": "node scripts/sync-translations.mjs",
    "translations:setup": "node scripts/contentful-translations.mjs setup",
    "translations:push": "node scripts/contentful-translations.mjs push"
  },
  "dependencies": {
    "@contentful/live-preview": "^4.10.26",
    "@contentful/rich-text-react-renderer": "^16.2.1",
    "@dival-sehgal/design-tokens": "*",
    "@dival-sehgal/next-config": "*",
    "@dival-sehgal/ui": "*",
    "@dival-sehgal/utils": "*",
    "@radix-ui/react-toast": "^1.2.23",
    "@react-three/fiber": "^9.5.0",
    "@tsparticles/engine": "^3.0.2",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.9.1",
    "@upstash/redis": "^1.38.0",
    "@xyflow/react": "^12.11.6",
    "clsx": "^2.1.1",
    "framer-motion": "^12.36.0",
    "graphql": "^16.13.2",
    "graphql-request": "^7.4.0",
    "lenis": "^1.3.0",
    "next": "16.3.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^9",
    "three": "^0.183.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@dival-sehgal/eslint-config": "*",
    "@dival-sehgal/jest-config": "*",
    "@dival-sehgal/tsconfig": "*",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@next/bundle-analyzer": "^16.2.6",
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.183.1",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "postcss": "^8.4.29",
    "sass": "^1.77.8",
    "stylelint": "^17.0.0",
    "wrangler": "^4.87.0"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "not dead"
  ]
}
