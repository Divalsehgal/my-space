# Copy to .env.local and fill in real values. Nothing here is a real secret.

# --- Contentful (required) ---------------------------------------------
# Content model that drives the site (pages fetch this at build/request time).
CONTENTFUL_SPACE_ID=
# Delivery API (read-only, published) and Preview API (read-only, drafts):
# Space settings → API keys. Never put a management (CFPAT-) token here.
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_PREVIEW_ACCESS_TOKEN=
# Shared secret for draft previews. Contentful → Settings → Content preview →
# Blog Page URL: https://<site>/api/preview?secret=<this>&slug={entry.fields.slug}
# Without it the /preview routes are unreachable in production.
CONTENTFUL_PREVIEW_SECRET=

# --- Site metadata --------------------------------------------------------
# Canonical origin used for OpenGraph/Twitter/JSON-LD/sitemap URLs.
# Falls back to https://divalsehgal.vercel.app if unset.
NEXT_PUBLIC_BASE_URL=

# --- Analytics (optional) --------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ADS_ID=
NEXT_PUBLIC_GTM_ID=

# --- Chatbot widget ---------------------------------------------------------
# Falls back to the deployed Cloudflare Worker if unset.
NEXT_PUBLIC_CHATBOT_URL=
# Shared secret the /api/revalidate route uses to trigger a chatbot re-seed
# after Contentful content changes.
CHATBOT_SEED_SECRET=

# --- ISR revalidation ---------------------------------------------------
# Shared secret required by /api/revalidate (Contentful webhook target).
REVALIDATION_SECRET=

# --- Blog view/analytics admin endpoints -----------------------------------
# Server-only. Sign in at /owner with this value to turn on owner mode (your
# visits aren't counted; /api/blogs/[slug]/analytics becomes available).
# Never expose it with a NEXT_PUBLIC_ prefix — that ships it to every browser.
ADMIN_VIEW_SECRET=

# --- Upstash Redis (blog view counts) --------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Notion (contact form submissions) -------------------------------------
NOTION_API_KEY=
NOTION_CONTACT_DB_ID=

# --- Misc (optional) --------------------------------------------------------
# Any value other than the default forces AnimatedImageBlock's fallback
# image loader instead of next/image's built-in one.
NEXT_PUBLIC_IMAGE_LOADER=
# Only for `yarn translations:setup` / `translations:push` (Contentful personal access token). Never needed at build time.
CONTENTFUL_MANAGEMENT_TOKEN=
