# Copy to .env.local and fill in real values. Nothing here is a real secret.

# --- Contentful (required) ---------------------------------------------
# Content model that drives the site (pages fetch this at build/request time).
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_PREVIEW_ACCESS_TOKEN=

# --- Site metadata --------------------------------------------------------
# Canonical origin used for OpenGraph/Twitter/JSON-LD/sitemap URLs.
# Falls back to https://divalsehgal.vercel.app if unset.
NEXT_PUBLIC_BASE_URL=

# --- Analytics (optional) --------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ADS_ID=
NEXT_PUBLIC_GTM_ID=

# --- Chatbot widget ---------------------------------------------------------
# Falls back to the deployed Cloudflare Worker if unset.
NEXT_PUBLIC_CHATBOT_URL=
# Shared secret the /api/revalidate route uses to trigger a chatbot re-seed
# after Contentful content changes.
CHATBOT_SEED_SECRET=

# --- ISR revalidation ---------------------------------------------------
# Shared secret required by /api/revalidate (Contentful webhook target).
REVALIDATION_SECRET=

# --- Blog view/analytics admin endpoints -----------------------------------
# Server-side secret gating /api/blogs/[slug]/view and /analytics.
ADMIN_VIEW_SECRET=
# Client-side counterpart used by ownerMode to unlock the owner-only UI.
NEXT_PUBLIC_ADMIN_VIEW_SECRET=

# --- Upstash Redis (blog view counts) --------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Notion (contact form submissions) -------------------------------------
NOTION_API_KEY=
NOTION_CONTACT_DB_ID=

# --- Misc (optional) --------------------------------------------------------
# Any value other than the default forces AnimatedImageBlock's fallback
# image loader instead of next/image's built-in one.
NEXT_PUBLIC_IMAGE_LOADER=
