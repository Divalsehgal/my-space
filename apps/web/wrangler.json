{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "ai-chatbot-widget",
    "main": "src/worker/index.ts",
    "compatibility_date": "2025-12-23",
    "observability": {
        "enabled": true
    },
    "triggers": {
        "crons": [
            "0 3 * * *"
        ]
    },
    "ai": {
        "binding": "AI",
        "remote": true
    },
    "vars": {
        "CHAT_CONTEXT_URL": "https://divalsehgal.vercel.app/api/chat-context",
        "CONTACT_API_URL": "https://divalsehgal.vercel.app/api/contact"
    },
    "vectorize": [
        {
            "binding": "VECTORIZE",
            "index_name": "faq-vectors",
            "remote": true
        }
    ],
    "kv_namespaces": [
        {
            "binding": "CHAT_SESSIONS",
            "id": "ffb5298350b14bf1824de6dc93a2e0c6"
        }
    ],
    "ratelimits": [
        {
            "name": "CHAT_RATE_LIMITER",
            "namespace_id": "1001",
            "simple": {
                "limit": 20,
                "period": 60
            }
        }
    ]
}
