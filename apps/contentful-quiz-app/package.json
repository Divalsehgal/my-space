{
  "name": "contentful-quiz-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3001",
    "build": "tsc --noEmit && vite build",
    "upload": "npx @contentful/app-scripts@4.1.16 upload --bundle-dir ./dist",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "sync:content-model": "node scripts/sync-content-model.mjs",
    "migrate:quiz-content": "node scripts/migrate-quiz-content.mjs"
  },
  "dependencies": {
    "@contentful/app-sdk": "^4.25.0",
    "@contentful/f36-components": "^4.0.0",
    "@contentful/react-apps-toolkit": "^1.0.0",
    "dotenv": "^16.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@dival-sehgal/quiz": "*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "@dival-sehgal/eslint-config": "*",
    "@dival-sehgal/jest-config": "*",
    "@dival-sehgal/tsconfig": "*"
  }
}
