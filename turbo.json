{
  "$schema": "https://turbo.build/json-schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "build": {
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "build/**"
      ],
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.turbo/**"
      ],
      "env": [
        "CONTENTFUL_SPACE_ID",
        "CONTENTFUL_ENVIRONMENT",
            "CONTENTFUL_ACCESS_TOKEN",
        "CONTENTFUL_PREVIEW_ACCESS_TOKEN",
        "NEXT_PUBLIC_*",
        "VITE_*",
        "ANALYZE"
      ],
      "passThroughEnv": [
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "NOTION_API_KEY",
        "NOTION_CONTACT_DB_ID",
        "REVALIDATION_SECRET",
        "CHATBOT_SEED_SECRET",
        "ADMIN_VIEW_SECRET",
        "VERCEL_*"
      ]
    },
    "build:report": {
      "outputs": [
        "coverage/**"
      ],
      "cache": false,
      "dependsOn": [
        "build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!coverage/**",
        "!.turbo/**"
      ],
      "outputs": [],
      "cache": true
    },
    "test:coverage": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!coverage/**",
        "!.turbo/**"
      ],
      "outputs": [
        "coverage/**"
      ],
      "cache": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!coverage/**",
        "!.next/**",
        "!.turbo/**"
      ],
      "outputs": [],
      "cache": true
    },
    "lint:style": {
      "inputs": [
        "src/**/*.scss"
      ],
      "outputs": [],
      "cache": true
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!coverage/**",
        "!.next/**",
        "!.turbo/**"
      ],
      "outputs": [],
      "cache": true
    },
    "test:e2e": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "passThroughEnv": [
        "CI",
        "E2E_*",
        "CONTENTFUL_*",
        "NEXT_PUBLIC_*",
        "UPSTASH_REDIS_*",
        "NOTION_*"
      ]
    },
    "generate:graphql": {
      "outputs": [],
      "cache": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.turbo/**"
      ]
    }
  },
  "globalDependencies": [
    ".env",
    ".env.local",
    ".stylelintrc.json"
  ]
}
