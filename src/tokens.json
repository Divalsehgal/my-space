{
  "colors": {
    "primary": "#adc178",
    "primary700": "#6c584c",
    "secondary": "#dde5b6",
    "accent": "#a98467",
    "bg": "#f0ead2",
    "surface": "#ffffff",
    "text": "#6c584c",
    "border": "#a98467",
    "success": "#16c79a",
    "warning": "#f7b500",
    "error": "#e63946",
    "info": "#3a86ff"
  },

  "typography": {
    "fonts": {
      "headline": "StackSans Headline, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial",
      "body": "StackSans Headline, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial"
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "sizes": {
      "h1": "2.5rem",
      "h2": "2rem",
      "h3": "1.5rem",
      "h4": "1.25rem",
      "h5": "1.125rem",
      "body": "1rem",
      "small": "0.875rem"
    },
    "lineHeights": {
      "tight": 1.1,
      "base": 1.5,
      "relaxed": 1.75
    }
  },
  "spacing": {
    "2xs": "2px",
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "48px",
    "3xl": "64px"
  },
  "radii": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "20px",
    "full": "9999px"
  },
  "shadows": {
    "xs": "0 1px 2px rgba(0,0,0,0.05)",
    "sm": "0 2px 4px rgba(0,0,0,0.08)",
    "md": "0 4px 8px rgba(0,0,0,0.12)",
    "lg": "0 6px 20px rgba(0,0,0,0.18)"
  },
  "transitions": {
    "fast": "0.15s ease-in-out",
    "base": "0.25s ease",
    "slow": "0.4s ease"
  },
  "breakpoints": {
    "xs": "480px",
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  },
  "zIndex": {
    "tooltip": 1000,
    "modal": 1200,
    "overlay": 1100,
    "header": 900,
    "dropdown": 950
  },
  "meta": {
    "maxWidthContainer": "1200px"
  },
  "fonts": {
    "families": {
      "StackSans Headline": [
        {
          "weight": 300,
          "file": "/fonts/StackSansHeadline-ExtraLight.ttf",
          "style": "normal",
          "format": "truetype"
        },
        {
          "weight": 400,
          "file": "/fonts/StackSansHeadline-Light.ttf",
          "style": "normal",
          "format": "truetype"
        },
        {
          "weight": 500,
          "file": "/fonts/StackSansHeadline-Regular.ttf",
          "style": "normal",
          "format": "truetype"
        },
        {
          "weight": 600,
          "file": "/fonts/StackSansHeadline-Medium.ttf",
          "style": "normal",
          "format": "truetype"
        },
        {
          "weight": 700,
          "file": "/fonts/StackSansHeadline-SemiBold.ttf",
          "style": "normal",
          "format": "truetype"
        },
        {
          "weight": 800,
          "file": "/fonts/StackSansHeadline-Bold.ttf",
          "style": "normal",
          "format": "truetype"
        }
      ]
    },
    "fallbacks": {
      "headline": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial",
      "body": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial"
    }
  }
}
