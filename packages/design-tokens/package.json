{
  "name": "@dival-sehgal/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Design tokens for colors, spacing, typography, layout, and motion",
  "author": "Dival Sehgal",
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "clean": "rm -rf build",
    "build": "node build-tokens.js",

    "watch": "style-dictionary build --config config.light.json --watch"

  },
  "exports": {
    "./light": {
      "types": "./build/ts/variables.light.d.ts",
      "import": "./build/ts/variables.light.js",
      "default": "./build/ts/variables.light.js"
    },
    "./dark": {
      "types": "./build/ts/variables.dark.d.ts",
      "import": "./build/ts/variables.dark.js",
      "default": "./build/ts/variables.dark.js"
    },
    "./variables.js": {
      "types": "./build/ts/variables.light.d.ts",
      "import": "./build/ts/variables.light.js",
      "default": "./build/ts/variables.light.js"
    },
    "./variables.scss": "./build/scss/variables.scss",
    "./variables.dark.scss": "./build/scss/variables.dark.scss",
    "./light.css": "./build/css/variables.light.css",
    "./dark.css": "./build/css/variables.dark.css"
  }

,
  "devDependencies": {
    "style-dictionary": "^4.3.3"
  }
}