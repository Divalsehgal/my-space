{
  "name": "@dival-sehgal/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Token-styled UI primitives (buttons, fields, icons...). Shipped as TypeScript source and compiled by the consuming Next.js app (transpilePackages).",
  "license": "MIT",
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "exports": {
    "./button": "./src/Button/index.tsx",
    "./icon-button": "./src/IconButton/index.tsx",
    "./skeleton": "./src/Skeleton/index.tsx",
    "./spinner": "./src/Spinner/index.tsx",
    "./text-field": "./src/TextField/index.tsx",
    "./tooltip": "./src/Tooltip/index.tsx",
    "./icons": "./src/icons.tsx",
    "./styles/motion": "./src/styles/_motion.scss"
  },
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:style": "stylelint 'src/**/*.scss'"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-tooltip": "^1.2.16",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@dival-sehgal/design-tokens": "*"
  },
  "devDependencies": {
    "@dival-sehgal/jest-config": "*",
    "@dival-sehgal/eslint-config": "*",
    "@dival-sehgal/tsconfig": "*"
  }
}
